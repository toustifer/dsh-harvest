{
  "name": "dsh-harvest",
  "version": "0.3.0",
  "description": "Cross-platform research tools for Codex MCP and DSH, with evidence-first Skill workflows.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "research",
    "multi-platform",
    "scout",
    "extract",
    "verify",
    "audit",
    "investigation",
    "codex",
    "mcp",
    "skill"
  ],
  "type": "module",
  "main": "lib/adapters/dsh/index.js",
  "exports": {
    ".": "./lib/adapters/dsh/index.js",
    "./core": "./lib/core/tools.js",
    "./mcp": "./lib/adapters/mcp/server.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "skills",
    ".codex-plugin",
    ".mcp.json",
    "instructions",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "LICENSE",
    "ATTRIBUTION.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "yaml": "2.9.1",
    "zod": "4.6.2"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "harvest-mcp": "bin/harvest-mcp.mjs",
    "harvest-doctor": "bin/harvest-doctor.mjs"
  },
  "scripts": {
    "test": "npm run build && node --test test/*.test.mjs",
    "doctor": "node bin/harvest-doctor.mjs",
    "start": "node bin/harvest-mcp.mjs",
    "build": "node scripts/build-plugin.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
